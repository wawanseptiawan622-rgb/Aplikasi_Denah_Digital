# ============================================================
# Contoh Virtual Host Laragon (OPSIONAL - Laragon biasanya
# membuatnya otomatis). Simpan sebagai:
#   C:\laragon\etc\apache2\sites-enabled\auto.denah-digital.test.conf
# lalu Laragon > Menu > Apache > Reload.
# ============================================================
define ROOT "C:/laragon/www/denah-digital/public"
define SITE "denah-digital.test"

<VirtualHost *:80>
    DocumentRoot "${ROOT}"
    ServerName ${SITE}
    ServerAlias *.${SITE}
    <Directory "${ROOT}">
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
